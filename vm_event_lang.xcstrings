    "ad_idfa_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Werbung unterstützt unser Geschäft. Tippen Sie im nächsten Bildschirm auf „Zulassen“, um uns die Erlaubnis zu geben, relevantere Anzeigen für Sie anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To do this, we request permission for ad-related access. Allowing or declining is entirely your choice and won’t affect your app experience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los anuncios ayudan a mantener nuestro negocio. Toque en “Permitir” en la siguiente pantalla para darnos permiso de mostrarle anuncios más relevantes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los anuncios nos ayudan a mantenernos. Pulsa “Permitir” en la siguiente pantalla para autorizar anuncios más relevantes para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les publicités nous aident à soutenir notre activité. Appuyez sur « Autoriser » à l’écran suivant pour nous permettre d’afficher des annonces plus pertinentes pour vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके लिए हमें विज्ञापन-संबंधित अनुमति की आवश्यकता है। अनुमति देना या न देना पूरी तरह आपका निर्णय है और इससे ऐप के सामान्य उपयोग पर कोई प्रभाव नहीं पड़ेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "広告は私たちのサービスを支えています。次の画面で「許可」をタップすると、より関連性の高い広告を表示できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "광고는 저희 비즈니스를 지원합니다. 다음 화면에서 ‘허용’을 눌러 더 관련성 높은 광고가 표시되도록 권한을 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Iklan membantu menyokong perniagaan kami. Ketik ‘Benarkan’ pada skrin seterusnya untuk memberikan kebenaran bagi menunjukkan iklan yang lebih relevan kepada anda."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para isso, precisamos solicitar permissão relacionada a anúncios. Permitir ou não é totalmente sua escolha e não afetará o uso normal do aplicativo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para isso, precisamos solicitar permissão relacionada a anúncios. Permitir ou não é totalmente sua escolha e não afetará o uso normal do aplicativo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para isso, precisamos solicitar permissão relacionada a anúncios. Permitir ou não é totalmente sua escolha e não afetará o uso normal do aplicativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为此，我们需要申请广告权限。是否授权由您决定，不会影响应用的正常使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為此，我們需要申請廣告權限。是否授權由您決定，不會影響應用的正常使用。"
          }
        }
      }
    },
