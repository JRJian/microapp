    "event_exchange_rule" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte gib unten den Einlösecode ein, den du per E-Mail erhalten hast. Bei Problemen kannst du uns jederzeit per E-Mail kontaktieren.\n\nNach erfolgreicher Einlösung würden wir uns freuen, wenn du uns eine positive Bewertung im App Store hinterlässt. Vielen Dank."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter the redemption code received in your email below. If you encounter any issues, feel free to contact us via email.\n\nAfter successful redemption, we'd appreciate if you could leave us a positive review on the App Store. \n\nThank you very much."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, introduce el código de canje recibido en tu correo electrónico a continuación. Si encuentras algún problema, no dudes en contactarnos por correo electrónico.\n\nDespués de un canje exitoso, agradeceríamos que nos dejaras una reseña positiva en la App Store. Muchas gracias."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, introduce el código de canje recibido en tu correo electrónico a continuación. Si encuentras algún problema, no dudes en contactarnos por correo electrónico.\n\nDespués de un canje exitoso, agradeceríamos que nos dejaras una reseña positiva en la App Store. Muchas gracias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez entrer le code d'échange reçu dans votre email ci-dessous. Si vous rencontrez des problèmes, n'hésitez pas à nous contacter par email.\n\nAprès un échange réussi, nous apprécierions que vous nous laissiez un avis positif sur l'App Store. Merci beaucoup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールで受け取った交換コードを以下に入力してください。問題がある場合は、メールでお問い合わせください。\n\n交換成功後、App Storeで好評価のレビューをいただければ幸いです。ありがとうございます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일로 받은 교환 코드를 아래에 입력해 주세요. 문제가 있으면 이메일로 문의해 주세요.\n\n성공적인 교환 후, App Store에 긍정적인 리뷰를 남겨주시면 감사하겠습니다. 대단히 감사합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila masukkan kod penebusan yang diterima di e-mel anda di bawah. Jika anda menghadapi sebarang masalah, jangan ragu untuk menghubungi kami melalui e-mel.\n\nSelepas penebusan yang berjaya, kami akan menghargai jika anda memberi ulasan positif di App Store. Terima kasih banyak."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, insira o código de resgate recebido no seu e-mail abaixo. Se encontrar algum problema, não hesite em nos contatar por e-mail.\n\nApós um resgate bem-sucedido, agradeceríamos se você nos deixasse uma avaliação positiva na App Store. Muito obrigado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, insira o código de resgate recebido no seu e-mail abaixo. Se encontrar algum problema, não hesite em nos contatar por e-mail.\n\nApós um resgate bem-sucedido, agradeceríamos se você nos deixasse uma avaliação positiva na App Store. Muito obrigado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, insira o código de resgate recebido no seu e-mail abaixo. Se encontrar algum problema, não hesite em nos contatar por e-mail.\n\nApós um resgate bem-sucedido, agradeceríamos se você nos deixasse uma avaliação positiva na App Store. Muito obrigado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在下方输入您邮箱收到的活动兑换码，如遇到任何问题，都可以发邮件咨询。\n\n兑换成功后，想求您在App Store给我们一个好评，非常感谢。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在下方輸入您在電子郵件中收到的兌換碼。如果遇到任何問題，請隨時透過電子郵件與我們聯繫。\n\n成功兌換後，如果您能在App Store上留下正面評價，我們將不勝感激。\n\n非常感謝。"
          }
        }
      }
    },
