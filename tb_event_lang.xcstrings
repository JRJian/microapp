    "event_detail_rule" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine TubePod-Erfahrung und erhalte nach erfolgreicher Prüfung TubePod Premium kostenlos.\n\nJe besser dein Beitrag abschneidet, desto größer ist deine Belohnung – bis hin zu Premium auf Lebenszeit!\n\n⸻\n\n🏆 Belohnungen\n\n🎉 Veröffentliche einen qualifizierten Beitrag → 1 Monat Premium\n\n🔥 50+ Likes & 750+ Aufrufe → 1 Jahr Premium\n\n🏆 100+ Likes & 1.500+ Aufrufe → Premium auf Lebenszeit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your TubePod experience and get TubePod Premium for free after your submission is approved.\n\nThe better your content performs, the bigger the reward — up to Lifetime Premium!\n\n⸻\n\n🏆 Rewards\n\n🎉 Publish a qualifying post → 1 Month Premium\n\n🔥 50+ Likes & 750+ Views → 1 Year Premium\n\n🏆 100+ Likes & 1,500+ Views → Lifetime Premium"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
