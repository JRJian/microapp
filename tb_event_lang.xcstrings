    "event_alert_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTeile einfach einen TubePod-Beitrag in sozialen Medien, um ein kostenloses TubePod Premium zu erhalten!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nJust share a TubePod post on social media to get a free TubePod Premium!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n¡Simplemente comparte una publicación de TubePod en redes sociales para obtener TubePod Premium gratis!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n¡Simplemente comparte una publicación de TubePod en redes sociales para obtener TubePod Premium gratis!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nPartagez simplement une publication TubePod sur les réseaux sociaux pour obtenir TubePod Premium gratuitement !"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTubePodの投稿をSNSでシェアするだけで、TubePod Premiumを無料でゲット！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n소셜 미디어에서 TubePod 게시물을 공유하기만 하면 TubePod Premium을 무료로 받을 수 있습니다!"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKongsi siaran TubePod di media sosial untuk mendapatkan TubePod Premium percuma!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCompartilhe simplesmente uma publicação do TubePod nas redes sociais para obter o TubePod Premium grátis!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCompartilhe simplesmente uma publicação do TubePod nas redes sociais para obter o TubePod Premium grátis!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCompartilhe simplesmente uma publicação do TubePod nas redes sociais para obter o TubePod Premium grátis!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n只需在社交平台分享一条TubePod的帖子，即可免费领取TubePod 会员！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n只需在社交媒體上分享TubePod貼文，即可免費獲得TubePod Premium！"
